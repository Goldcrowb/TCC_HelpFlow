# Copie para .env apenas no ambiente local; não envie segredos para o GitHub.
PORT=3000
NODE_ENV=development
# Produção: gerar pelo menos 32 bytes aleatórios; na Render, usar Environment > Generate.
SESSION_SECRET=
# Banco online compartilhado: configure as duas variáveis em produção.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Apenas para teste temporário sem banco: os dados são perdidos ao reiniciar.
# DEMO_MEMORY_MODE=1
