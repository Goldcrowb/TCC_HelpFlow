{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/dominio/**/*.ts", "src/aplicacao/**/*.ts",
    "src/persistencia/**/*.ts", "src/servicos/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
